-- =========================================================
-- 부서이동자 모니터링 모듈 DDL  (DB: PostgreSQL, schema: dept_transfer)
-- =========================================================
-- 실행 순서:
--   1. spec/program_change/ddl  (set_updated_at, guard_closed_period, monitoring_period)
--   2. 이 파일
-- =========================================================

CREATE SCHEMA IF NOT EXISTS dept_transfer;


-- ── daily_record — 일간 자동 적재 (7일 뷰 UPSERT) ───────────
CREATE TABLE dept_transfer.daily_record (
    id             BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    record_type    VARCHAR(20)  NOT NULL,
    -- 퇴직자 | 부서변경자 | 전자조달권한 | PMS권한
    empno          VARCHAR(20)  NOT NULL,
    emp_name       VARCHAR(50),
    change_date    DATE         NOT NULL,
    dept_code      VARCHAR(50),
    dept_name      VARCHAR(100),
    prev_dept_name VARCHAR(100),
    role_code      VARCHAR(50),
    role_key       VARCHAR(50)  NOT NULL DEFAULT '-',
    -- COALESCE(role_code, '-') 를 앱에서 채움 — UPSERT unique key 용
    role_name      VARCHAR(200),
    reg_date       DATE,
    action         VARCHAR(10),            -- 유지 | 회수 | NULL(미처리)
    sr_no          VARCHAR(30),
    sr_title       VARCHAR(300),           -- SR 자동 매핑
    sr_work_type   VARCHAR(50),            -- SR 자동 매핑
    remark         VARCHAR(500),
    processed_by   BIGINT,                 -- auth.app_user.id (추후 FK 추가)
    processed_at   TIMESTAMP,
    first_seen     DATE         NOT NULL DEFAULT CURRENT_DATE,
    last_seen      DATE         NOT NULL DEFAULT CURRENT_DATE,
    created_at     TIMESTAMP    NOT NULL DEFAULT now(),
    updated_at     TIMESTAMP    NOT NULL DEFAULT now(),
    CONSTRAINT uq_daily_record
        UNIQUE (record_type, empno, change_date, role_key)
);

CREATE TRIGGER trg_daily_updated
    BEFORE UPDATE ON dept_transfer.daily_record
    FOR EACH ROW EXECUTE FUNCTION program_change.set_updated_at();

CREATE INDEX idx_daily_change_date ON dept_transfer.daily_record (change_date);
CREATE INDEX idx_daily_empno       ON dept_transfer.daily_record (empno);
CREATE INDEX idx_daily_action      ON dept_transfer.daily_record (action);
CREATE INDEX idx_daily_rtype       ON dept_transfer.daily_record (record_type);

COMMENT ON TABLE  dept_transfer.daily_record             IS '일간 부서이동자 조회 결과 (7일 뷰 UPSERT)';
COMMENT ON COLUMN dept_transfer.daily_record.record_type IS '퇴직자|부서변경자|전자조달권한|PMS권한';
COMMENT ON COLUMN dept_transfer.daily_record.role_key    IS 'COALESCE(role_code,''-'') — UPSERT key';
COMMENT ON COLUMN dept_transfer.daily_record.action      IS '유지|회수|NULL(미처리)';
COMMENT ON COLUMN dept_transfer.daily_record.first_seen  IS '최초 조회일, UPSERT 시 보존';
COMMENT ON COLUMN dept_transfer.daily_record.last_seen   IS '최근 조회일, 매일 갱신';


-- ── monthly_record — 월간 모니터링 (월초 1회) ────────────────
CREATE TABLE dept_transfer.monthly_record (
    id             BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    period_id      BIGINT       NOT NULL,
    system_code    VARCHAR(20)  NOT NULL,  -- 공통 | PMS | HR | EPRO
    empno          VARCHAR(20)  NOT NULL,
    emp_name       VARCHAR(50),
    change_date    DATE,
    dept_name      VARCHAR(100),
    prev_dept_name VARCHAR(100),
    role_code      VARCHAR(50),
    role_key       VARCHAR(50)  NOT NULL DEFAULT '-',
    role_name      VARCHAR(200),
    reg_date       DATE,
    revoke_date    DATE,                   -- 권한회수일 (reviewer 입력)
    sr_no          VARCHAR(30),
    sr_title       VARCHAR(300),
    sr_work_type   VARCHAR(50),
    remark         VARCHAR(500),
    created_at     TIMESTAMP    NOT NULL DEFAULT now(),
    updated_at     TIMESTAMP    NOT NULL DEFAULT now(),
    CONSTRAINT fk_monthly_period
        FOREIGN KEY (period_id) REFERENCES program_change.monitoring_period(id),
    CONSTRAINT uq_monthly_record
        UNIQUE (period_id, system_code, empno, role_key)
);

CREATE TRIGGER trg_monthly_updated
    BEFORE UPDATE ON dept_transfer.monthly_record
    FOR EACH ROW EXECUTE FUNCTION program_change.set_updated_at();

CREATE TRIGGER trg_guard_monthly
    BEFORE INSERT OR UPDATE OR DELETE ON dept_transfer.monthly_record
    FOR EACH ROW EXECUTE FUNCTION program_change.guard_closed_period();

CREATE INDEX idx_monthly_period_sys ON dept_transfer.monthly_record (period_id, system_code);
CREATE INDEX idx_monthly_empno      ON dept_transfer.monthly_record (empno);

COMMENT ON TABLE  dept_transfer.monthly_record             IS '월간 부서이동자 모니터링 결과';
COMMENT ON COLUMN dept_transfer.monthly_record.system_code IS '공통|PMS|HR|EPRO';
COMMENT ON COLUMN dept_transfer.monthly_record.revoke_date IS '권한회수일 — reviewer 입력';

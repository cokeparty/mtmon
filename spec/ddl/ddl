-- =========================================================
-- DDL 모니터링 모듈 DDL  (DB: PostgreSQL, schema: ddl)
-- ENUM 타입 미사용 — VARCHAR 컬럼으로 대체
-- =========================================================
-- 실행 순서:
--   1. spec/program_change/ddl
--   2. spec/DML/ddl
--   3. 이 파일 (ddl 스키마 테이블)
-- =========================================================

CREATE SCHEMA IF NOT EXISTS ddl;


-- ── ddl_log ───────────────────────────────────────────────
CREATE TABLE ddl.ddl_log (
    id            BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    period_id     BIGINT        NOT NULL,
    system_code   VARCHAR(10)   NOT NULL,
    request_time  TIMESTAMP     NOT NULL,
    db_user       VARCHAR(50)   NOT NULL,
    conn_account  VARCHAR(50)   NOT NULL,
    target_object VARCHAR(150)  NOT NULL,
    ddl_type      VARCHAR(10)   NOT NULL,  -- CREATE|ALTER|DROP|TRUNCATE|RENAME
    query_summary TEXT,
    is_abnormal   BOOLEAN       NOT NULL DEFAULT FALSE,
    sr_no         VARCHAR(30),
    status        VARCHAR(10)   NOT NULL DEFAULT '미입력',  -- 미입력 | 적용됨
    created_at    TIMESTAMP     NOT NULL DEFAULT now(),
    CONSTRAINT fk_ddl_period
        FOREIGN KEY (period_id) REFERENCES program_change.monitoring_period(id)
);

CREATE INDEX idx_ddl_period_sys ON ddl.ddl_log (period_id, system_code);
CREATE INDEX idx_ddl_request    ON ddl.ddl_log (request_time);
CREATE INDEX idx_ddl_type       ON ddl.ddl_log (ddl_type);
CREATE INDEX idx_ddl_abnormal   ON ddl.ddl_log (is_abnormal) WHERE is_abnormal = TRUE;
CREATE INDEX idx_ddl_status     ON ddl.ddl_log (status);
CREATE INDEX idx_ddl_sr         ON ddl.ddl_log (sr_no);

COMMENT ON TABLE  ddl.ddl_log              IS 'DDL 모니터링 (DBSAFER CSV 적재 + SR 입력)';
COMMENT ON COLUMN ddl.ddl_log.ddl_type     IS 'CREATE | ALTER | DROP | TRUNCATE | RENAME';
COMMENT ON COLUMN ddl.ddl_log.is_abnormal  IS 'DROP/TRUNCATE 자동 마킹';
COMMENT ON COLUMN ddl.ddl_log.status       IS '미입력 | 적용됨';


-- ── 마감 회차 보호 트리거 ─────────────────────────────────
CREATE TRIGGER trg_guard_ddl
    BEFORE INSERT OR UPDATE OR DELETE ON ddl.ddl_log
    FOR EACH ROW EXECUTE FUNCTION program_change.guard_closed_period();

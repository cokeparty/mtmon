-- =========================================================
-- 프로그램 변경 리스트 모듈 DDL  (DB: PostgreSQL, schema: program_change)
-- ENUM 타입 미사용 — VARCHAR 컬럼으로 대체
-- =========================================================

-- ── 스키마 생성 ───────────────────────────────────────────
CREATE SCHEMA IF NOT EXISTS program_change;


-- ── 공통 함수 ─────────────────────────────────────────────
CREATE OR REPLACE FUNCTION program_change.set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION program_change.guard_closed_period()
RETURNS TRIGGER AS $$
DECLARE
    v_status VARCHAR(10);
    v_pid    BIGINT;
BEGIN
    v_pid := COALESCE(NEW.period_id, OLD.period_id);

    SELECT status INTO v_status
      FROM program_change.monitoring_period
     WHERE id = v_pid;

    IF v_status = 'closed' THEN
        RAISE EXCEPTION '마감된 회차(period_id=%)는 변경할 수 없습니다.', v_pid
            USING ERRCODE = 'check_violation';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ── 1) 월 회차 ────────────────────────────────────────────
CREATE TABLE program_change.monitoring_period (
    id         BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    year_month CHAR(7)      NOT NULL UNIQUE,      -- 'YYYY-MM'
    status     VARCHAR(10)  NOT NULL DEFAULT 'open',  -- open | closed
    closed_at  TIMESTAMP,
    closed_by  VARCHAR(50),                        -- 추후 auth.app_user FK 예정
    created_at TIMESTAMP    NOT NULL DEFAULT now()
);

COMMENT ON TABLE  program_change.monitoring_period            IS '월별 모니터링 회차';
COMMENT ON COLUMN program_change.monitoring_period.year_month IS 'YYYY-MM 형식';
COMMENT ON COLUMN program_change.monitoring_period.status     IS 'open=수정가능, closed=조회전용';


-- ── 2) 시스템별 수집 설정 ─────────────────────────────────
CREATE TABLE program_change.server_config (
    id               BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    system_code      VARCHAR(10)  NOT NULL UNIQUE,  -- HR | EPRO | SR | PMS

    -- A 서버 (xferlog 로그서버)
    ssh_host         VARCHAR(100) NOT NULL,
    ssh_port         INTEGER      NOT NULL DEFAULT 22,
    ssh_user         VARCHAR(50)  NOT NULL,
    ssh_key_path     VARCHAR(300),
    ssh_password     VARCHAR(200),
    log_dir          VARCHAR(300) NOT NULL,
    log_pattern      VARCHAR(100) NOT NULL,    -- 예: *{ym}*
    include_path     VARCHAR(300) NOT NULL,
    include_flag     VARCHAR(50)  NOT NULL,

    -- B 서버 (NFS)
    nfs_ssh_host     VARCHAR(100),
    nfs_ssh_port     INTEGER      DEFAULT 22,
    nfs_ssh_user     VARCHAR(50),
    nfs_ssh_key_path VARCHAR(300),
    nfs_ssh_password VARCHAR(200),
    nfs_base_dir     VARCHAR(300),

    updated_at TIMESTAMP NOT NULL DEFAULT now()
);

CREATE TRIGGER trg_server_config_updated
    BEFORE UPDATE ON program_change.server_config
    FOR EACH ROW EXECUTE FUNCTION program_change.set_updated_at();

COMMENT ON TABLE  program_change.server_config             IS '시스템별 로그수집·SR매핑 접속 설정';
COMMENT ON COLUMN program_change.server_config.log_pattern IS '{ym}=YYYYMM 치환 패턴';


-- ── 3) 프로그램 변경 로그 ─────────────────────────────────
CREATE TABLE program_change.program_change_log (
    id          BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    period_id   BIGINT       NOT NULL,
    system_code VARCHAR(10)  NOT NULL,  -- HR | EPRO | SR | PMS

    -- ① xferlog 원본
    log_month   SMALLINT,
    log_day     SMALLINT,
    log_time    TIME,
    deploy_time TIMESTAMP    NOT NULL,
    file_name   VARCHAR(255) NOT NULL,
    full_path   VARCHAR(500),
    deployer    VARCHAR(50),

    -- ② NFS 매핑
    nfs_path  VARCHAR(700),
    nfs_mtime TIMESTAMP,
    map_type  VARCHAR(30)  NOT NULL DEFAULT 'none',
    -- 값: none | single | session_anchor | check | time_resolved | reverse_resolved

    -- ③ SR DB 스냅샷
    sr_no          VARCHAR(30),
    sr_title       VARCHAR(300),
    sr_work_type   VARCHAR(50),
    sr_approved_at DATE,
    sr_closed_at   DATE,
    sr_developer   VARCHAR(50),
    sr_reviewer    VARCHAR(50),

    -- ④ 결재 3컬럼 (항상 NULL 유지)
    approval_change_request VARCHAR(50),
    approval_user_test      VARCHAR(50),
    approval_pre_deploy     VARCHAR(50),

    -- ⑤ 판정
    result    VARCHAR(20) NOT NULL DEFAULT 'SR없음',  -- 정상|SR없음|경고|이상
    normal_yn VARCHAR(10) NOT NULL DEFAULT '이상',    -- 정상|이상
    reason    VARCHAR(500),

    -- ⑥ 운영
    remark     VARCHAR(500),
    created_at TIMESTAMP NOT NULL DEFAULT now(),
    updated_at TIMESTAMP NOT NULL DEFAULT now(),

    CONSTRAINT fk_pcl_period
        FOREIGN KEY (period_id) REFERENCES program_change.monitoring_period(id),
    CONSTRAINT uq_pcl_dedup
        UNIQUE (period_id, system_code, deploy_time, file_name)
);

CREATE TRIGGER trg_pcl_updated_at
    BEFORE UPDATE ON program_change.program_change_log
    FOR EACH ROW EXECUTE FUNCTION program_change.set_updated_at();

CREATE TRIGGER trg_guard_pcl
    BEFORE INSERT OR UPDATE OR DELETE ON program_change.program_change_log
    FOR EACH ROW EXECUTE FUNCTION program_change.guard_closed_period();

CREATE INDEX idx_pcl_period_system ON program_change.program_change_log (period_id, system_code);
CREATE INDEX idx_pcl_deploy_time   ON program_change.program_change_log (deploy_time);
CREATE INDEX idx_pcl_sr_no         ON program_change.program_change_log (sr_no);
CREATE INDEX idx_pcl_file_name     ON program_change.program_change_log (file_name);
CREATE INDEX idx_pcl_result        ON program_change.program_change_log (result);

COMMENT ON TABLE  program_change.program_change_log         IS '프로그램 변경 리스트 (xferlog + NFS 매핑 + SR 판정)';
COMMENT ON COLUMN program_change.program_change_log.map_type IS 'none|single|session_anchor|check';
COMMENT ON COLUMN program_change.program_change_log.result   IS '정상|SR없음|경고|이상';
COMMENT ON COLUMN program_change.program_change_log.normal_yn IS '정상|이상 (최종 정상여부)';

# ============================================================
#  월간모니터링 통합대시보드 설정 양식
#  - 새 서버에서는 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
#  - .env 는 서버마다 따로 두고, 소스 배포 시 덮어쓰지 않습니다.
#  - 항목 설명은 config.py 참고
#  - URL 안의 비밀번호에 @ : / % # ! 가 있으면 %40 %3A %2F %25 %23 %21 로 적습니다.
# ============================================================
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000

# 모니터링 DB (필수)
DATABASE_URL=postgresql+psycopg2://사용자:비밀번호@호스트:5432/mtmon
AUTO_MIGRATE=true

# SR DB
SR_DB_URL=postgresql+psycopg2://사용자:비밀번호@호스트:5432/ehr
EMERGENCY_GRACE_DAYS=5

# HR(Tibero) — 부서이동자 일간·월간 (조달구매·PMS 는 DB 링크로 조회). 서버에 Java 필요
TIBERO_DSN=10.100.1.130:8629/DXHR
TIBERO_USER=
TIBERO_PASSWORD=
TIBERO_JDBC_JAR=lib/tibero7-jdbc.jar
JAVA_HOME=

# 메일 (SMTP) — 부서이동자 일간 결과 메일
SMTP_HOST=203.241.0.125
SMTP_PORT=25
SMTP_HELO=kmdev.poscodx.com
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=pe912821@poscodx.com
DEPART_DAILY_MAIL_TO=받는사람1@poscodx.com,받는사람2@poscodx.com
DEPART_DAILY_MAIL_CC=
APP_BASE_URL=

# 로그
LOG_DIR=/data/mtmon/logs
LOG_LEVEL=INFO

# 배치 스케줄러 (false 면 자동 실행 중지, 화면 수동 실행은 가능)
SCHEDULER_ENABLED=true

# 세션 / 보안 (필수) — 서버마다 다른 긴 임의 문자열
SECRET_KEY=
SESSION_MAX_AGE=28800
HTTPS_ONLY=false

# 계정 초기 비밀번호
INITIAL_PASSWORD=

# 개발/임시 계정 — 운영은 비워둡니다
DEV_LOGIN_ID=
DEV_LOGIN_PW=
DEV_USER_NAME=임시관리자
DEV_USER_ROLE=

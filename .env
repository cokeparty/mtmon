# ============================================================
#  월간모니터링 통합대시보드 설정 — 개발계(로컬 PC)
#  - 서버마다 이 파일만 고쳐서 사용합니다. 소스 배포 시 덮어쓰지 마세요.
#  - 항목 설명은 config.py, 빈 양식은 .env.example 참고
#  - URL 안의 비밀번호에 @ : / % # ! 가 있으면 %40 %3A %2F %25 %23 %21 로 적습니다.
# ============================================================
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# 모니터링 DB
DATABASE_URL=postgresql+psycopg2://mtmonu:Mtmon2357%21@localhost:5432/mtmon
AUTO_MIGRATE=true

# SR DB (개발계에서 조회가 필요하면 값 입력)
SR_DB_URL=
EMERGENCY_GRACE_DAYS=5

# HR(Tibero) (부서이동자) — 개발계에서 수집이 필요하면 값 입력
TIBERO_DSN=10.100.1.130:8629/DXHR
TIBERO_USER=
TIBERO_PASSWORD=
TIBERO_JDBC_JAR=lib/tibero7-jdbc.jar
JAVA_HOME=

# 메일 (SMTP) — 개발계는 비워 두면 메일 배치가 '설정 없음'으로 실패함
SMTP_HOST=
SMTP_PORT=25
SMTP_HELO=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEPART_DAILY_MAIL_TO=
DEPART_DAILY_MAIL_CC=
APP_BASE_URL=http://127.0.0.1:8000

# 로그
LOG_DIR=logs
LOG_LEVEL=INFO

# 배치 스케줄러 — 개발계는 자동 실행 끔 (배치 화면에서 수동 실행 가능)
SCHEDULER_ENABLED=false

# 세션 / 보안
SECRET_KEY=b82e6e0bb33135f6ef1be874c79e6728fed1a340782297d78f8b5961490482cc
SESSION_MAX_AGE=28800
HTTPS_ONLY=false

# 계정 초기 비밀번호
INITIAL_PASSWORD=Mtmon12#

# 개발/임시 계정 (DB 없이 로그인할 때만, 운영은 비워둘 것)
DEV_LOGIN_ID=admin
DEV_LOGIN_PW=admin
DEV_USER_NAME=임시관리자
DEV_USER_ROLE=reviewer
